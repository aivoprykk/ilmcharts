doctype html
- min = (dev  ? '' : '.min')
html(lang=opt.lang)
	head
		title= opt.title + (dev  ? ' :: R&D' : '')
		meta(charset=opt.charset)
		meta(name="viewport", content="width=device-width")
		meta(name="description" content=opt.desc)
		link(rel="stylesheet", href= opt.css + min + '.css?' + opt.version, media="screen")
		link(rel="shortcut icon" type="image/x-icon" href="css/images/favicon.ico")
		// [if lt IE 9]><script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script><![endif]
	body.sans
		nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.fixed-top
			div.container-fluid
				a#pagelogo.navbar-brand(href="/") Ilm
				button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#ilm-navbar-collapse-1")
					span.navbar-toggler-icon
				#ilm-navbar-collapse-1.collapse.navbar-collapse.justify-content-end
					ul.navbar-nav.mb-2.mb-lg-0
						li.nav-item.dropdown
							a.nav-link.dropdown-toggle#ilm-seaded(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false") Seaded
							.dropdown-menu#ilm-seaded-dropdown(style="overflow-y:scroll;max-height:90vh;width:16rem;right:0; left:auto" aria-labelledby="ilm-seaded" data-offset="2" )
						li.nav-item.dropdown
							a.nav-link#ilm-viited(href="#" role="button" data-bs-toggle="dropdown") Viited
						li.nav-item.dropdown.dropleft
							a.nav-link.dropdown-toggle#ilmlinks(href="#" role="button" data-bs-toggle="dropdown"  aria-expanded="false") Info
							.dropdown-menu(aria-labelledby="ilmlinks" style="right:0;left:auto")
								a.dropdown-item(href="http://balticroads.net/") Maanteeinfo
								a.dropdown-item(href="http://ilmateenistus.ee/") Ilmateenistus
								a.dropdown-item(href="http://energia.emu.ee/") Maaülikool
								a.dropdown-item(href="http://yr.no/") Yr
								a.dropdown-item(href="http://windguru.cz/") Windguru
								.dropdown-divider
								a.dropdown-item(href="http://jquery.com/") JQuery
								a.dropdown-item(href="http://highcharts.com/") Highcharts
								a.dropdown-item(href="http://getbootstrap.com/") Bootstrap
								.dropdown-divider
								a.dropdown-item(href=opt.giturl) Projekt GitHubis
		#backgr.ilm-backgr: img(src="css/images/ranna-001.jpg" alt="Peipsi pilt")
		#bghide.ilm-bghide
		#dots.ilm-dots
		#sisu.ilm-sisu.nopadding
			.container-fluid
				.row.g-1
					#menu-container.menu.col-lg-5.col-sm-6.col-xs-12
					.chart-container.chart.col-lg-7.col-sm-6.col-xs-12
		#popup.ilm-popup.panel.panel-primary(style="display:none;")
			#popup_in.panel-heading
				b.panel-title
					a#sl.ilm-sl(href="#" onclick="return ilm.Popup.render();") Sulge
			#lingid.panel-body
		#ilm-modal.ilm-modal.modal.fade(role="dialog" tabindex="-1" aria-labelledby="ilm-modal" aria-hidden="true")
			.modal-dialog.modal-dialog-centered.modal-lg(role="document")
				.modal-content
					.modal-header
						h5.modal-title.popup-title Pealkiri
					.modal-body
						.container-fluid.popup-sisu Oodake, laadin sisu ...
		script(src= opt.contrib + min + '.js')
		script(src= opt.js + min + '.js?' + opt.version)
		script(async="" defer="" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBKPcJDwBUmu-xio9gPQsi-FjWtY_9XQmg&callback=ilm.loadMap")

